---
import Article from '../layouts/Article.astro';
import ExternalLinkIcon from './ExternalLinkIcon.astro';
import { useTranslations, type AlternateLinks } from '../i18n/utils';
import { htmlLang, type Lang } from '../i18n/ui';
import type { Article as ArticleData } from '../data/articles';

interface Props {
  article: ArticleData;
  lang: Lang;
  canonical: string;
  alternates: AlternateLinks;
}

const { article, lang, canonical, alternates } = Astro.props;
const t = useTranslations(lang);
const localized = article[lang];

const ogImageAbsolute = `https://roman-purtow.ru${article.image}`;
const homePath = lang === 'en' ? '/en/' : '/';
const homeName = lang === 'en' ? 'Home' : 'Главная';
const headlinePlain = localized.h1.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();

const articleJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": localized.ogTitle,
      "description": localized.ogDescription,
      "image": ogImageAbsolute,
      "url": canonical,
      "inLanguage": htmlLang[lang],
      "datePublished": article.datePublished,
      "dateModified": article.dateModified || article.datePublished,
      "author": { "@type": "Person", "name": "Роман Пуртов", "url": "https://roman-purtow.ru" },
      "publisher": {
        "@type": "Person",
        "name": "Роман Пуртов",
        "url": "https://roman-purtow.ru",
        "image": "https://roman-purtow.ru/images/favicon.png"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonical
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": homeName, "item": `https://roman-purtow.ru${homePath}` },
        { "@type": "ListItem", "position": 2, "name": headlinePlain, "item": canonical }
      ]
    }
  ]
};
---

<Article
  title={localized.title}
  description={localized.description}
  ogTitle={localized.ogTitle}
  ogDescription={localized.ogDescription}
  ogImage={ogImageAbsolute}
  ogUrl={canonical}
  jsonLd={articleJsonLd}
  lang={lang}
  alternates={alternates}
  canonical={canonical}
>
    <header class="article-header">
        <h1 class="article-title" set:html={localized.h1} />
        <p class="article-meta" set:html={localized.metaLine} />
    </header>

    <div class="article-body">
        <p set:html={localized.body} />

        {article.tech && (
            <p><strong>{t('tech.label')}:</strong> {article.tech}</p>
        )}

        {article.siteUrl && article.siteDisplay && (
            <a class="article-site-link" href={article.siteUrl} rel="nofollow noopener noreferrer" target="_blank">
                <ExternalLinkIcon />
                {article.siteDisplay}
            </a>
        )}

        {article.screenshotUrl && article.siteUrl && (
            article.screenshotFramed ? (
                <figure class="screenshot-browser">
                    <div class="screenshot-browser__bar" aria-hidden="true">
                        <span></span><span></span><span></span>
                    </div>
                    <div class="screenshot-browser__scroll" data-drag-scroll>
                        <img src={article.screenshotUrl} alt={localized.screenshotAlt} loading="lazy" draggable="false">
                    </div>
                </figure>
            ) : (
                <a href={article.siteUrl} rel="nofollow noopener noreferrer" target="_blank"><img src={article.screenshotUrl} alt={localized.screenshotAlt} loading="lazy"></a>
            )
        )}
    </div>
</Article>

<script>
    // Drag-to-scroll для превью-скриншота в «окне браузера»:
    // тянем мышью вверх-вниз прямо по картинке (колёсико и скроллбар тоже работают).
    function initDragScroll() {
        const containers = document.querySelectorAll<HTMLElement>('[data-drag-scroll]');
        containers.forEach((el) => {
            if (el.dataset.dragScrollReady === '1') return;
            el.dataset.dragScrollReady = '1';

            let isDown = false;
            let startY = 0;
            let startScroll = 0;
            let moved = false;

            const onPointerDown = (e: PointerEvent) => {
                if (e.button !== 0) return; // только ЛКМ
                isDown = true;
                moved = false;
                startY = e.clientY;
                startScroll = el.scrollTop;
                el.classList.add('is-grabbing');
                el.setPointerCapture(e.pointerId);
            };

            const onPointerMove = (e: PointerEvent) => {
                if (!isDown) return;
                const delta = e.clientY - startY;
                if (Math.abs(delta) > 2) moved = true;
                el.scrollTop = startScroll - delta;
                e.preventDefault();
            };

            const endDrag = (e: PointerEvent) => {
                if (!isDown) return;
                isDown = false;
                el.classList.remove('is-grabbing');
                try {
                    el.releasePointerCapture(e.pointerId);
                } catch {}
            };

            el.addEventListener('pointerdown', onPointerDown);
            el.addEventListener('pointermove', onPointerMove);
            el.addEventListener('pointerup', endDrag);
            el.addEventListener('pointercancel', endDrag);
            // не даём «улетать» выделению/перетаскиванию картинки
            el.addEventListener('dragstart', (e) => e.preventDefault());
        });
    }

    initDragScroll();
    document.addEventListener('astro:after-swap', initDragScroll);
</script>
