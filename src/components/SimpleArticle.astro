---
import Article from '../layouts/Article.astro';
import ExternalLinkIcon from './ExternalLinkIcon.astro';
import { useTranslations, type AlternateLinks } from '../i18n/utils';
import { type Lang } from '../i18n/ui';
import type { Article as ArticleData } from '../data/articles';
import { articleGraph } from '../data/schema';
import sharp from 'sharp';

interface Props {
  article: ArticleData;
  lang: Lang;
  canonical: string;
  alternates: AlternateLinks;
}

const { article, lang, canonical, alternates } = Astro.props;
const t = useTranslations(lang);
const localized = article[lang];

const hasScreenshot = Boolean(article.screenshotUrl && article.siteUrl);
const hasSiteLink = Boolean(article.siteUrl && article.siteDisplay);

const coverAbsolute = `https://roman-purtow.ru${article.image}`;
// Для соцсетей — отдельная версия 1200×630 (scripts/build-og-images.mjs):
// обложки кейсов бывают 4:3, а summary_large_image ждёт 1.91:1.
const ogImageAbsolute = coverAbsolute.replace(/\/cover\.jpg$/, '/og.jpg');
const articleJsonLd = articleGraph(article, lang, canonical);

// Скриншот — первый крупный элемент кейса, то есть LCP. Грузим его сразу и
// с размерами из файла, иначе вёрстка прыгает, когда он догружается.
const screenshotSize = hasScreenshot
  ? await sharp(`public${article.screenshotUrl}`).metadata()
  : undefined;
---

<Article
  title={localized.title}
  description={localized.description}
  ogTitle={localized.ogTitle}
  ogDescription={localized.ogDescription}
  ogImage={ogImageAbsolute}
  ogUrl={canonical}
  jsonLd={articleJsonLd}
  lang={lang}
  alternates={alternates}
  canonical={canonical}
>
    <header class="article-header">
        <h1 class="article-title" set:html={localized.h1} />
        <p class="article-meta" set:html={localized.metaLine} />
    </header>

    <div class="article-body">
        {hasScreenshot && (
            article.screenshotFramed ? (
                <figure class="screenshot-browser">
                    <div class="screenshot-browser__bar" aria-hidden="true">
                        <span></span><span></span><span></span>
                    </div>
                    <div class="screenshot-browser__scroll" data-drag-scroll>
                        <img src={article.screenshotUrl} alt={localized.screenshotAlt} width={screenshotSize?.width} height={screenshotSize?.height} fetchpriority="high" draggable="false">
                    </div>
                </figure>
            ) : (
                <a href={article.siteUrl} rel="nofollow noopener noreferrer" target="_blank"><img src={article.screenshotUrl} alt={localized.screenshotAlt} width={screenshotSize?.width} height={screenshotSize?.height} fetchpriority="high"></a>
            )
        )}

        {hasScreenshot && hasSiteLink && (
            <a class="article-site-link" href={article.siteUrl} rel="nofollow noopener noreferrer" target="_blank">
                <ExternalLinkIcon />
                {article.siteDisplay}
            </a>
        )}

        {localized.body.split('\n\n').map((para) => (
            <p set:html={para} />
        ))}

        {article.tech && (
            <p><strong>{t('tech.label')}:</strong> {article.tech}</p>
        )}

        {!hasScreenshot && hasSiteLink && (
            <a class="article-site-link" href={article.siteUrl} rel="nofollow noopener noreferrer" target="_blank">
                <ExternalLinkIcon />
                {article.siteDisplay}
            </a>
        )}
    </div>
</Article>
