---
import Article from '../layouts/Article.astro';
import { type AlternateLinks } from '../i18n/utils';
import { type Lang } from '../i18n/ui';
import type { Article as ArticleData } from '../data/articles';
import { articleGraph } from '../data/schema';

interface Props {
  article: ArticleData;
  lang: Lang;
  canonical: string;
  alternates: AlternateLinks;
}

const { article, lang, canonical, alternates } = Astro.props;
const localized = article[lang];

const coverAbsolute = `https://roman-purtow.ru${article.image}`;
// Для соцсетей — отдельная версия 1200×630 (scripts/build-og-images.mjs):
// обложки кейсов бывают 4:3, а summary_large_image ждёт 1.91:1.
const ogImageAbsolute = coverAbsolute.replace(/\/cover\.jpg$/, '/og.jpg');
const articleJsonLd = articleGraph(article, lang, canonical);
---

<Article
  title={localized.title}
  description={localized.description}
  ogTitle={localized.ogTitle}
  ogDescription={localized.ogDescription}
  ogImage={ogImageAbsolute}
  ogUrl={canonical}
  jsonLd={articleJsonLd}
  lang={lang}
  alternates={alternates}
  canonical={canonical}
>
    <header class="article-header">
        <h1 class="article-title" set:html={localized.h1} />
        <p class="article-meta" set:html={localized.metaLine} />
    </header>

    <div class="article-body" set:html={localized.body} />
</Article>
