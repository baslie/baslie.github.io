---
import VCardIntro from './VCardIntro.astro';
import VCardContacts from './VCardContacts.astro';
import VCardSocials from './VCardSocials.astro';
import VCardLinks from './VCardLinks.astro';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  /** 'article' — визитка-спутник на странице кейса: имя не h1, фото ленивые */
  variant?: 'home' | 'article';
}

const { lang, variant = 'home' } = Astro.props;
const t = useTranslations(lang);
---

<!-- data-lenis-prevent: на невысоких экранах визитка прокручивается внутри себя,
     и колесо мыши над ней не должно уходить в плавный скролл страницы -->
<div class="vcard" data-lenis-prevent>
  <VCardIntro lang={lang} variant={variant} />

  <hr class="vcard__divider" />

  <VCardContacts lang={lang} />

  <!-- На планшете соцсети и ссылки встают в одну строку, поэтому у них общая обёртка -->
  <div class="vcard__bottom">
    <VCardSocials lang={lang} />
    <VCardLinks lang={lang} />
  </div>

  <footer class="vcard__legal">
    <p>{t('footer.name')}</p>
    <p>{t('footer.inn')}</p>
  </footer>
</div>
