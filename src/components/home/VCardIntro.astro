---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  /** На главной имя — заголовок страницы, на статье h1 уже занят её заголовком */
  variant?: 'home' | 'article';
}

const { lang, variant = 'home' } = Astro.props;
const t = useTranslations(lang);

const isHome = variant === 'home';
const NameTag = isHome ? 'h1' : 'p';
// На статье колонка скрыта до 1200px — грузить фото заранее там незачем
const defaultImageLoading = isHome ? undefined : 'lazy';
---

<div class="vcard__head">
  <!-- Классы .profile-image* сохранены: на них завязаны CSS-ховер и тап-переключение в app.js -->
  <div class="profile-image-wrapper">
    <img
      src="/images/roman.webp"
      alt={t('profile.name')}
      class="profile-image profile-image--default"
      width="132"
      height="132"
      loading={defaultImageLoading}
      fetchpriority={isHome ? 'high' : undefined}
      itemprop="image"
    />
    <img
      src="/images/roman-lol.webp"
      alt={t('profile.name')}
      class="profile-image profile-image--hover"
      width="132"
      height="132"
      loading="lazy"
    />
  </div>

  <div class="vcard__who">
    <NameTag class="vcard__name">{t('profile.name')}</NameTag>
    <p class="vcard__about" set:html={t('profile.about')}></p>
    <p class="vcard__joke">{t('profile.joke')}</p>
  </div>
</div>
