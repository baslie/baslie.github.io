---
import CornerNav from './CornerNav.astro';
import CardProfile from './CardProfile.astro';
import BentoCard from './BentoCard.astro';
import ArticleCard from './ArticleCard.astro';
import ContactsModal from './ContactsModal.astro';
import { mainButtons } from '../data/cards';
import { getArticleCards } from '../data/articles';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const articleCards = getArticleCards(lang);
const currentPath = Astro.url.pathname;
---

<CornerNav lang={lang} currentPath={currentPath} />

<!-- Bento Grid -->
<div class="lg:flex lg:items-center lg:justify-center lg:px-12 lg:pt-12 xl:px-16 xl:pt-16 2xl:px-20 2xl:pt-20">
  <main class="
    grid grid-cols-1
    lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)]
    gap-3 md:gap-4 xl:gap-5 2xl:gap-6
    mx-3 mt-3 md:mx-4 md:mt-4 lg:mx-0 lg:mt-0
    lg:w-full lg:max-w-[90rem]
  ">
    <div class="bento-card card-profile lg:row-span-2">
      <CardProfile lang={lang} />
    </div>

    {mainButtons.map(card => (
      <BentoCard
        card={card}
        lang={lang}
        as={card.type === 'contacts-modal' ? 'button' : 'a'}
      />
    ))}
  </main>
</div>

<ContactsModal lang={lang} />

<!-- Articles -->
<section class="articles-section mt-3 md:mt-4 xl:mt-5 2xl:mt-6 lg:flex lg:justify-center lg:px-12 xl:px-16 2xl:px-20">
  <div class="px-3 pb-3 md:px-4 md:pb-4 lg:p-0 lg:w-full lg:max-w-[90rem]">
    <h2 class="articles-heading">{t('articles.heading')}</h2>
    <div class="articles-grid">
      {articleCards.map(article => <ArticleCard article={article} lang={lang} />)}
    </div>
  </div>
</section>

<footer class="site-footer py-6 text-center text-sm">
  <p>{t('footer.name')}</p>
  <p>{t('footer.inn')}</p>
</footer>
