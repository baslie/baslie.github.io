---
import CornerNav from './CornerNav.astro';
import VCard from './home/VCard.astro';
import Feed from './home/Feed.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const currentPath = Astro.url.pathname;
---

<CornerNav lang={lang} currentPath={currentPath} />

<!-- Две колонки: слева липкая визитка, справа лента. На узких экранах
     визитка становится обычной карточкой и уезжает наверх. -->
<div class="home">
  <aside class="home__aside">
    <VCard lang={lang} />
  </aside>

  <main class="home__main">
    <Feed lang={lang} />
  </main>
</div>
