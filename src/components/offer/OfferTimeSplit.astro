---
// Инфографика «на что уходит время»: доля смыслов раньше и сейчас.
// Две колонки, в каждой полоса из двух отрезков и подписи ровно под ними
const rows = [
  { label: 'Раньше', think: 18, thinkText: '15–20%', doText: '80–85%' },
  { label: 'Сейчас', think: 80, thinkText: 'около 80%', doText: 'около 20%', accent: true },
];
---

<figure class="o3-timesplit">
  {rows.map((row) => (
    <div class="o3-timesplit-col" aria-hidden="true">
      <span class:list={['o3-timesplit-label', { 'is-accent': row.accent }]}>{row.label}</span>
      <div class="o3-timesplit-track" style={`grid-template-columns: minmax(0, ${row.think}fr) minmax(0, ${100 - row.think}fr)`}>
        <span class="o3-timesplit-seg is-think"></span>
        <span class="o3-timesplit-seg is-do"></span>
        <span class="o3-timesplit-note is-think"><b>{row.thinkText}</b>смыслы</span>
        <span class="o3-timesplit-note is-do"><b>{row.doText}</b>вёрстка и запуск</span>
      </div>
    </div>
  ))}
  <div class="sr-only">
    <table>
      <caption>На что уходит время проекта</caption>
      <thead>
        <tr><th></th><th>Маркетинг, смыслы, визуальная идея</th><th>Вёрстка, настройка, запуск</th></tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr><th>{row.label}</th><td>{row.thinkText}</td><td>{row.doText}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
</figure>
