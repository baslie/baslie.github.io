---
// Инфографика «на что уходит время»: доля смыслов раньше и сейчас
const rows = [
  { label: 'Раньше', think: 18, thinkText: '15–20%', doText: '80–85%' },
  { label: 'Сейчас', think: 80, thinkText: 'около 80%', doText: 'около 20%', accent: true },
];
---

<figure class="o3-timesplit">
  {rows.map((row) => (
    <div class="o3-timesplit-row" aria-hidden="true">
      <span class:list={['o3-timesplit-label', { 'is-accent': row.accent }]}>{row.label}</span>
      <div class="o3-timesplit-bar"><span style={`width: ${row.think}%`}></span></div>
      <span class="o3-timesplit-caption">смыслы {row.thinkText} · вёрстка и запуск {row.doText}</span>
    </div>
  ))}
  <div class="sr-only">
    <table>
      <caption>На что уходит время проекта</caption>
      <thead>
        <tr><th></th><th>Маркетинг, смыслы, визуальная идея</th><th>Вёрстка, настройка, запуск</th></tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr><th>{row.label}</th><td>{row.thinkText}</td><td>{row.doText}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
</figure>
