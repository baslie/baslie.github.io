---
import sharp from 'sharp';
import { getArticleBySlug } from '../../data/articles';

// Работы для страницы 3: slug кейса и короткий комментарий.
// Скриншот берётся из кейса (screenshotUrl) и листается в «окне браузера»
const works = [
  {
    slug: 'dhira-tomsk',
    name: 'DHIRA в Томске',
    note: 'Лендинг мантра-концерта Дхиры: всё о вечере на одной странице, а билет — через мессенджер или звонок организатору.',
  },
  {
    slug: 'fbo24',
    name: 'FBO Центр',
    note: 'Сайт сервиса, который готовит грузы для складов Ozon. Дизайн перенёс в код до мелочей.',
  },
  {
    slug: 'ehomestroy',
    name: 'ЭкоHomeСтрой',
    note: 'Редизайн сайта застройщика: вместо рендеров — витрина реально построенных домов и фото с площадок. Плюс проработанные карточки проектов.',
  },
  {
    slug: 'derevyannie-gryadki',
    name: 'Деревянные грядки',
    note: 'Лендинг томского производителя грядок с калькулятором заказа в семь шагов. Подтвердили гипотезу — отработал сезон в плюс.',
  },
  {
    slug: 'sibananda-retrit',
    name: 'СибАНАНДА',
    note: 'Лендинг первого в Сибири ретрита по Крия-йоге — на Кедровой заимке под Томском.',
  },
  {
    slug: 'js-jig',
    name: 'JS JIG',
    note: 'Интернет-магазин рыболовной фурнитуры с оплатой через Ozon Pay и админкой. От дизайна в Фигме до первых платежей — 2 недели.',
  },
];

const items = await Promise.all(
  works.map(async (w) => {
    const article = getArticleBySlug(w.slug);
    if (!article?.screenshotUrl) return null;
    const { width, height } = await sharp(`public${article.screenshotUrl}`).metadata();
    // Адрес показываем текстом без ссылки: пусть человек сам скопирует его в браузер
    const address = article.siteUrl?.replace(/^https?:\/\//, '').replace(/\/$/, '');
    return { ...w, src: article.screenshotUrl, width, height, address };
  }),
);

// Высота всех окон — по самому короткому скриншоту, длинные листаются внутри
const shown = items.filter(Boolean);
const shortest = shown.reduce((a, b) => (b!.height! / b!.width! < a!.height! / a!.width! ? b : a), shown[0]);
const shotRatio = shortest ? `${shortest.width} / ${shortest.height}` : undefined;
---

<div class="o3-works" style={shotRatio && `--o3-shot-ratio: ${shotRatio}`}>
  {shown.map((w) => (
    <div
      class="o3-work"
      role="button"
      tabindex="0"
      aria-haspopup="dialog"
      aria-label={`Открыть скриншот сайта ${w!.name}`}
      data-work-open
      data-src={w!.src}
      data-name={w!.name}
      data-address={w!.address}
      data-width={w!.width}
      data-height={w!.height}
    >
      <figure class="o3-browser">
        <div class="o3-browser-bar" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div class="o3-browser-view">
          <div class="o3-browser-scroll" data-overlay-scroll>
            <img
              src={w!.src}
              alt={`Скриншот сайта ${w!.name}`}
              width={w!.width}
              height={w!.height}
              loading="lazy"
              decoding="async"
              draggable="false"
            />
          </div>
          <span class="o3-browser-thumb" aria-hidden="true"></span>
        </div>
      </figure>
      <span class="o3-work-name">{w!.name}</span>
      {w!.address && <span class="o3-work-address" data-no-open>{w!.address}</span>}
      <span class="o3-work-note">{w!.note}</span>
    </div>
  ))}
</div>

<!-- Лайтбокс: одно большое «окно браузера», наполняется данными кликнутой работы.
     data-lenis-prevent: колёсико внутри листает скриншот, а не страницу под попапом -->
<dialog class="o3-dialog o3-lightbox" aria-labelledby="o3-lightbox-title" data-work-dialog data-lenis-prevent>
  <figure class="o3-browser o3-lightbox-browser">
    <div class="o3-browser-bar o3-lightbox-bar">
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      <div class="o3-lightbox-title">
        <b id="o3-lightbox-title" data-work-name></b>
        <span class="o3-lightbox-address" data-work-address></span>
      </div>
      <button type="button" class="o3-lightbox-close" aria-label="Закрыть" data-work-close>&times;</button>
    </div>
    <div class="o3-browser-view o3-lightbox-view">
      <div class="o3-browser-scroll o3-lightbox-scroll" tabindex="-1" data-drag-scroll data-overlay-scroll>
        <img alt="" draggable="false" decoding="async" data-work-img />
      </div>
      <span class="o3-browser-thumb" aria-hidden="true"></span>
    </div>
  </figure>
</dialog>

<script>
  import { initDragScroll } from '../../scripts/drag-scroll';

  // Полоса прокрутки поверх скриншота: системный скроллбар спрятан, ползунок рисуем сами
  const thumbUpdaters = new Map<HTMLElement, () => void>();
  document.querySelectorAll<HTMLElement>('[data-overlay-scroll]').forEach((el) => {
    const thumb = el.parentElement?.querySelector<HTMLElement>('.o3-browser-thumb');
    if (!thumb) return;
    const inset = 6;
    const update = () => {
      const max = el.scrollHeight - el.clientHeight;
      thumb.hidden = max <= 1;
      if (max <= 1) return;
      const track = el.clientHeight - inset * 2;
      const size = Math.max(28, (track * el.clientHeight) / el.scrollHeight);
      thumb.style.height = `${size}px`;
      thumb.style.transform = `translateY(${inset + ((track - size) * el.scrollTop) / max}px)`;
    };
    el.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    el.querySelector('img')?.addEventListener('load', update);
    update();
    thumbUpdaters.set(el, update);
  });

  const dialog = document.querySelector<HTMLDialogElement>('[data-work-dialog]');
  const scroll = dialog?.querySelector<HTMLElement>('.o3-lightbox-scroll');
  const img = dialog?.querySelector<HTMLImageElement>('[data-work-img]');
  let opener: HTMLElement | null = null;

  const refresh = () => {
    initDragScroll();
    if (scroll) thumbUpdaters.get(scroll)?.();
  };

  const open = (card: HTMLElement) => {
    if (!dialog || !scroll || !img) return;
    const { src = '', name = '', address = '', width = '', height = '' } = card.dataset;
    img.src = src;
    img.alt = `Скриншот сайта ${name}`;
    img.width = Number(width);
    img.height = Number(height);
    dialog.querySelector('[data-work-name]')!.textContent = name;
    dialog.querySelector('[data-work-address]')!.textContent = address;
    opener = card;
    dialog.showModal();
    scroll.scrollTop = 0;
    // фокус на окно со скриншотом: стрелки и PageDown сразу листают его
    scroll.focus({ preventScroll: true });
    refresh();
    if (!img.complete) img.addEventListener('load', refresh, { once: true });
  };

  document.querySelectorAll<HTMLElement>('[data-work-open]').forEach((card) => {
    card.addEventListener('click', (e) => {
      // адрес выделяется целиком для копирования, попап при этом не нужен
      if ((e.target as HTMLElement).closest('[data-no-open]')) return;
      open(card);
    });
    card.addEventListener('keydown', (e) => {
      if (e.target !== card || (e.key !== 'Enter' && e.key !== ' ')) return;
      e.preventDefault();
      open(card);
    });
  });

  if (dialog) {
    dialog.querySelector('[data-work-close]')?.addEventListener('click', () => dialog.close());
    // Клик по затемнению: событие приходит на сам <dialog>, а не на его содержимое
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      opener?.focus({ preventScroll: true });
      opener = null;
    });
  }
</script>
