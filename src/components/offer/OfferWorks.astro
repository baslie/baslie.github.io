---
import sharp from 'sharp';
import { getArticleBySlug } from '../../data/articles';

// Работы для страницы 3: slug кейса и короткий комментарий.
// Скриншот берётся из кейса (screenshotUrl) и листается в «окне браузера»
const works = [
  {
    slug: 'pech-polikarpova',
    name: 'Печь Поликарпова',
    note: 'Инженерную идею печи объяснили за десять экранов: от истории изобретения до патента и инструкции по растопке.',
  },
  {
    slug: 'glazami-schaefer',
    name: 'Глазами Шефер',
    note: 'Сайт личного бренда оптометриста: три сценария для трёх аудиторий и 50 итераций сайта за две недели.',
  },
  {
    slug: 'korea-motors',
    name: 'Korea Motors',
    note: 'Сайт заказа авто из Южной Кореи. Главная цель — привести человека в Telegram-канал компании.',
  },
  {
    slug: 'nutrilegal',
    name: 'Нутрилигал',
    note: 'Сайт консалтинга по регистрации БАД и СГР: сложную бюрократическую услугу разложили на понятные шаги.',
  },
];

const items = await Promise.all(
  works.map(async (w) => {
    const article = getArticleBySlug(w.slug);
    if (!article?.screenshotUrl) return null;
    const { width, height } = await sharp(`public${article.screenshotUrl}`).metadata();
    return { ...w, src: article.screenshotUrl, width, height };
  }),
);

// Высота всех окон — по самому короткому скриншоту, длинные листаются внутри
const shown = items.filter(Boolean);
const shortest = shown.reduce((a, b) => (b!.height! / b!.width! < a!.height! / a!.width! ? b : a), shown[0]);
const shotRatio = shortest ? `${shortest.width} / ${shortest.height}` : undefined;
---

<div class="o3-works" style={shotRatio && `--o3-shot-ratio: ${shotRatio}`}>
  {shown.map((w) => (
    <div class="o3-work">
      <figure class="o3-browser">
        <div class="o3-browser-bar" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div class="o3-browser-scroll" data-drag-scroll>
          <img
            src={w!.src}
            alt={`Скриншот сайта ${w!.name}`}
            width={w!.width}
            height={w!.height}
            loading="lazy"
            decoding="async"
            draggable="false"
          />
        </div>
      </figure>
      <a class="o3-work-name" href={`/articles/${w!.slug}/`}>{w!.name}</a>
      <span class="o3-work-note">{w!.note}</span>
    </div>
  ))}
</div>

<script>
  import { initDragScroll } from '../../scripts/drag-scroll';

  initDragScroll();
</script>
