---
import Base from '../../layouts/Base.astro';
import HomePage from '../../components/HomePage.astro';
import { useTranslations, getCanonicalAndAlternates } from '../../i18n/utils';
import { homeGraph } from '../../data/schema';

const lang = 'en' as const;
const t = useTranslations(lang);
const { canonical, alternates } = getCanonicalAndAlternates('/en/');

const homeJsonLd = homeGraph(lang, canonical, t('site.title'));
---
<Base
  title={t('site.title')}
  description={t('site.metaDescription')}
  lang={lang}
  canonical={canonical}
  alternates={alternates}
  ogUrl="https://roman-purtow.ru/en/"
  jsonLd={homeJsonLd}
>
  <HomePage lang={lang} />
</Base>
