---
import Base from './Base.astro';
import CornerNav from '../components/CornerNav.astro';
import VCard from '../components/home/VCard.astro';
import { useTranslations, type AlternateLinks } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
  jsonLd?: Record<string, unknown>;
  lang: Lang;
  alternates: AlternateLinks;
  canonical: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  ogUrl,
  jsonLd,
  lang,
  alternates,
  canonical,
} = Astro.props;

const t = useTranslations(lang);
const homeHref = lang === 'en' ? '/en/' : '/';
const currentPath = Astro.url.pathname;
---

<Base
  title={title}
  description={description}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  ogUrl={ogUrl ?? canonical}
  ogType="article"
  canonical={canonical}
  noPreload={true}
  jsonLd={jsonLd}
  lang={lang}
  alternates={alternates}
>
  <CornerNav lang={lang} currentPath={currentPath} showLang={true} homeLink={true} />

  <!-- Визитка едет спутником только на десктопе: ниже 1200px колонки нет,
       иначе до текста кейса пришлось бы прокручивать экран контактов. -->
  <div class="article-layout">
    <aside class="article-layout__aside">
      <VCard lang={lang} variant="article" />
    </aside>

    <main class="article-layout__main">
      <article class="article-container">
          <a href={homeHref} class="article-back">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
              <span>{t('article.back')}</span>
          </a>

          <slot />

          <a href={homeHref} class="article-back article-back--bottom">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
              <span>{t('article.back')}</span>
          </a>
      </article>
    </main>
  </div>
</Base>

<script>
    import { initDragScroll } from '../scripts/drag-scroll';

    initDragScroll();
    document.addEventListener('astro:after-swap', initDragScroll);
</script>

<style>
    body {
        min-height: 100vh;
    }

    /* До 1200px статья идёт как раньше, во всю ширину: визитка над текстом
       кейса стоила бы читателю целого экрана прокрутки. */
    .article-layout__aside {
        display: none;
    }

    .article-container {
        max-width: 720px;
        margin: 1rem auto 2rem;
        padding: 2.5rem 2.5rem 4rem;
        background: var(--card-bg);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
    }


    .article-back {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.875rem;
        margin-bottom: 2rem;
        transition: color 0.2s ease;
    }

    .article-back:hover {
        color: var(--brand-link);
    }

    @media (max-width: 767px) {
        .article-container {
            max-width: 100%;
            margin: 0;
            padding: 1.5rem 1rem 3rem;
            border-radius: 0;
            box-shadow: none;
        }
    }

    /* Десктоп: две колонки, как на главной */
    @media (min-width: 75rem) {
        .article-layout {
            display: grid;
            grid-template-columns: 420px minmax(0, 1fr);
        }

        /* Белую полосу во всю высоту несёт растянутый грид-айтем,
           а липнет сама визитка — правило для неё уже есть в input.css */
        .article-layout__aside {
            display: block;
            background: var(--surface-card);
        }

        /* Отступы как у ленты на главной: сверху место под фиксированный CornerNav */
        .article-layout__main {
            min-width: 0;
            padding: 3.5rem clamp(1.5rem, 3.33vw, 4rem) 5.5rem;
        }

        .article-container {
            margin: 0 auto;
        }
    }
</style>
