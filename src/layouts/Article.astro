---
import Base from './Base.astro';
import CornerNav from '../components/CornerNav.astro';
import { useTranslations, type AlternateLinks } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogUrl?: string;
  jsonLd?: Record<string, unknown>;
  lang: Lang;
  alternates: AlternateLinks;
  canonical: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  ogImage,
  ogUrl,
  jsonLd,
  lang,
  alternates,
  canonical,
} = Astro.props;

const t = useTranslations(lang);
const homeHref = lang === 'en' ? '/en/' : '/';
const currentPath = Astro.url.pathname;
---

<Base
  title={title}
  description={description}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  ogUrl={ogUrl ?? canonical}
  ogType="article"
  canonical={canonical}
  noPreload={true}
  jsonLd={jsonLd}
  lang={lang}
  alternates={alternates}
>
  <CornerNav lang={lang} currentPath={currentPath} showLang={true} homeLink={true} />

  <article class="article-container">
      <a href={homeHref} class="article-back">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          <span>{t('article.back')}</span>
      </a>

      <slot />

      <a href={homeHref} class="article-back article-back--bottom">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          <span>{t('article.back')}</span>
      </a>
  </article>
</Base>

<script>
    // Drag-to-scroll для превью-скриншота в «окне браузера»:
    // тянем мышью вверх-вниз прямо по картинке (колёсико и скроллбар тоже работают).
    function initDragScroll() {
        const containers = document.querySelectorAll<HTMLElement>('[data-drag-scroll]');
        containers.forEach((el) => {
            // курсор-«ручка» только когда есть что прокручивать
            const refreshScrollable = () => {
                el.classList.toggle('is-scrollable', el.scrollHeight > el.clientHeight + 1);
            };
            refreshScrollable();

            if (el.dataset.dragScrollReady === '1') return;
            el.dataset.dragScrollReady = '1';

            let isDown = false;
            let startY = 0;
            let startScroll = 0;
            let moved = false;

            const onPointerDown = (e: PointerEvent) => {
                if (e.button !== 0) return; // только ЛКМ
                if (el.scrollHeight <= el.clientHeight + 1) return; // нечего прокручивать
                isDown = true;
                moved = false;
                startY = e.clientY;
                startScroll = el.scrollTop;
                el.classList.add('is-grabbing');
                el.setPointerCapture(e.pointerId);
            };

            const onPointerMove = (e: PointerEvent) => {
                if (!isDown) return;
                const delta = e.clientY - startY;
                if (Math.abs(delta) > 2) moved = true;
                el.scrollTop = startScroll - delta;
                e.preventDefault();
            };

            const endDrag = (e: PointerEvent) => {
                if (!isDown) return;
                isDown = false;
                el.classList.remove('is-grabbing');
                try {
                    el.releasePointerCapture(e.pointerId);
                } catch {}
            };

            el.addEventListener('pointerdown', onPointerDown);
            el.addEventListener('pointermove', onPointerMove);
            el.addEventListener('pointerup', endDrag);
            el.addEventListener('pointercancel', endDrag);
            // не даём «улетать» выделению/перетаскиванию картинки
            el.addEventListener('dragstart', (e) => e.preventDefault());
            // пересчёт прокручиваемости при ресайзе/догрузке картинки
            window.addEventListener('resize', refreshScrollable);
            const img = el.querySelector('img');
            if (img && !img.complete) img.addEventListener('load', refreshScrollable);
        });
    }

    initDragScroll();
    document.addEventListener('astro:after-swap', initDragScroll);
</script>

<style>
    body {
        min-height: 100vh;
    }

    .article-container {
        max-width: 720px;
        margin: 1rem auto 2rem;
        padding: 2.5rem 2.5rem 4rem;
        background: var(--card-bg);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
    }

    :global(.dark) .article-container {
        background: var(--card-bg-dark);
        box-shadow: 0 4px 30px var(--card-shadow-dark);
    }

    .article-back {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--color-text-muted);
        text-decoration: none;
        font-size: 0.875rem;
        margin-bottom: 2rem;
        transition: color 0.2s ease;
    }

    .article-back:hover {
        color: var(--color-link);
    }

    :global(.dark) .article-back {
        color: rgba(255, 255, 255, 0.5);
    }

    :global(.dark) .article-back:hover {
        color: var(--color-link);
    }

    @media (max-width: 767px) {
        .article-container {
            max-width: 100%;
            margin: 0;
            padding: 1.5rem 1rem 3rem;
            border-radius: 0;
            box-shadow: none;
        }

        :global(.dark) .article-container {
            box-shadow: none;
        }
    }
</style>
