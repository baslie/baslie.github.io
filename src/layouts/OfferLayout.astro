---
import Base from './Base.astro';
import CornerNav from '../components/CornerNav.astro';
import { offerGraph } from '../data/schema';

interface Props {
  pageNumber: number;
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  /** Вилка цены для разметки услуги — только если она названа на самой странице */
  price?: { min: number; max: number };
}

const { pageNumber, title, description, ogTitle, ogDescription, ogImage, price } = Astro.props;

const BASE_URL = 'https://roman-purtow.ru/offer';
const pageUrl = `${BASE_URL}/${pageNumber}/`;
const offerJsonLd = offerGraph(pageUrl, title, description, price);
---

<Base
  title={title}
  description={description}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  ogImageWidth={1920}
  ogImageHeight={1080}
  ogUrl={pageUrl}
  canonical={pageUrl}
  jsonLd={offerJsonLd}
  noPreload={true}
  lang="ru"
>
  <CornerNav lang="ru" currentPath={Astro.url.pathname} showLang={false} homeLink={true} />
  <slot />
</Base>
